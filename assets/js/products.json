---
layout: null
---
[
  {% for product in site.products %}
  {
    "id": {{ product.id | jsonify }},
    "name": {{ product.name | jsonify }},
    "category": {{ product.category | jsonify }},
    "price": {{ product.price | jsonify }},
    "description": {{ product.description | jsonify }},
    "image": {{ product.image | jsonify }},
    "variants": [
      {% for variant in product.variants %}
      {
        "id": {{ variant.id | jsonify }},
        "color": {{ variant.color | jsonify }},
        "price": {{ variant.price | jsonify }},
        "image": {{ variant.image | jsonify }}
      }{% unless forloop.last %},{% endunless %}
      {% endfor %}
    ]
  }{% unless forloop.last %},{% endunless %}
  {% endfor %}
]

